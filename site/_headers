# Netlify response headers for idlery.com
# Docs: https://docs.netlify.com/routing/headers/
#
# The only change from the previous deploy is script-src: 'none' became 'self',
# so the one local file /assets/js/site.js can run (menu, hero video controls,
# carousel buttons). Inline scripts, inline styles and every other origin stay
# blocked. Video, fonts and images are same-origin and covered by default-src.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; form-action 'none'; frame-ancestors 'self'; base-uri 'self'

# Every page links the stylesheet, the script and the hero video with a
# content hash (?v=...) that scripts/build.py writes and `build.py --check`
# (run by make_zip.py and the site checks) verifies. A deploy that changes one
# of them changes its URL, so these can be cached for a year without ever
# pairing new HTML with an old stylesheet. HTML itself is always revalidated
# (Netlify's default for pages).
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/video/*
  Cache-Control: public, max-age=31536000, immutable

# Images and fonts keep their names when regenerated, so they stay short:
# an hour, then revalidate in the background.
/assets/img/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/assets/fonts/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/favicon.ico
  Cache-Control: public, max-age=86400
