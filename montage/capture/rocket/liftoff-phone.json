{
 "name": "liftoff-phone",
 "url": "http://127.0.0.1:4190/?v=mission&m=leo&quality=high",
 "w": 720,
 "h": 1560,
 "hideUI": true,
 "pre": 2,
 "frames": 125,
 "setup": [
  {
   "until": "window.__rocketFrame.location === 'flight' && window.__rocketFrame.n > 5",
   "max": 600
  },
  {
   "eval": "window.__rocketDirector.dissolve = null; window.__rocketDirector.mode = 'ground'; window.__rocketSeekMission(0.6); window.__rocketPlayback.player.setRate(1); window.__rocketPlayback.player.play()"
  }
 ],
 "outDir": "out/liftoff-phone"
}